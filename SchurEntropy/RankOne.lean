import SchurEntropy.Definitions
import Mathlib.Tactic.Ring

/-!
# Algebraic part of the rank-one reduction

These identities concern the actual block Schur product. The entropy-increment
order estimate and the zero-block normalization argument are separate obligations.
-/

noncomputable section
open scoped BigOperators Matrix

namespace SchurEntropy

variable {m : ℕ} {n : Fin m → ℕ}

/-- The column belonging to a block is supported only in that block. -/
def blockColumns (v : BlockIndex n → ℂ) : Matrix (BlockIndex n) (Fin m) ℂ :=
  fun a i => if a.1 = i then v a else 0

/-- The unnormalized rank-one matrix generated by a vector. -/
def outerProduct (u : BlockIndex n → ℂ) : BlockMatrix n :=
  fun a b => u a * star (u b)

/-- Unit vectors in mutually orthogonal blocks form a rectangular isometry. -/
theorem blockColumns_isometry (v : BlockIndex n → ℂ)
    (hv : ∀ i : Fin m, ∑ a : Fin (n i), star (v ⟨i, a⟩) * v ⟨i, a⟩ = 1) :
    (blockColumns v)ᴴ * blockColumns v = 1 := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, blockColumns,
    Fintype.sum_sigma]
  by_cases hij : i = j
  · subst j
    simpa [apply_ite, ite_mul, mul_ite] using hv i
  · simp [hij, Ne.symm hij, apply_ite]

/-- Block-supported columns turn a scalar matrix into its rank-one-block lift. -/
theorem blockColumns_mul (v : BlockIndex n → ℂ)
    (C : Matrix (Fin m) (Fin m) ℂ) :
    blockColumns v * C * (blockColumns v)ᴴ = blockSchur C (outerProduct v) := by
  ext a b
  simp [Matrix.mul_apply, blockColumns, Matrix.conjTranspose_apply,
    outerProduct, apply_ite, ite_mul]
  ring

/-- Scaling each block gives the scalar skeleton appearing in the manuscript. -/
theorem blockSchur_outerProduct_scaled
    (v : BlockIndex n → ℂ) (C : Matrix (Fin m) (Fin m) ℂ)
    (r : Fin m → ℝ) :
    blockSchur C (outerProduct (fun a => (Real.sqrt (r a.1) : ℂ) * v a)) =
      blockColumns v * scalarSkeleton C r * (blockColumns v)ᴴ := by
  rw [blockColumns_mul]
  ext a b
  simp [outerProduct, scalarSkeleton, scalarDiagonal,
    Matrix.diagonal_mul, Matrix.mul_diagonal]
  ring

/-- Pinching a rank-one-block lift corresponds to scalar diagonal pinching. -/
theorem pinching_blockColumns (v : BlockIndex n → ℂ)
    (A : Matrix (Fin m) (Fin m) ℂ) :
    pinching n (blockColumns v * A * (blockColumns v)ᴴ) =
      blockColumns v * Matrix.diagonal A.diag * (blockColumns v)ᴴ := by
  rw [blockColumns_mul, blockColumns_mul]
  ext a b
  simp only [pinching_apply, blockSchur_apply, Matrix.diagonal_apply, Matrix.diag_apply]
  split <;> simp_all

end SchurEntropy
