import SchurEntropy.Qubit.DecompositionRotation
import SchurEntropy.Qubit.OutputForm

noncomputable section
open Matrix QubitAdditivity
open scoped Matrix BigOperators ComplexOrder MatrixOrder MatrixMap

namespace SchurEntropy.Qubit

variable {n k : Type*} [Fintype n] [DecidableEq n] [Fintype k]

/-- The diagonal dual block of a Kraus row family. -/
def rowMass (p : k → n → ℂ) : Matrix n n ℂ :=
  ∑ j, vecMulVec (p j) (star (p j))

/-- The lower off-diagonal dual block of a pair of Kraus row families. -/
def rowCross (p q : k → n → ℂ) : Matrix n n ℂ :=
  ∑ j, vecMulVec (q j) (star (p j))

theorem rowCross_conjTranspose (p q : k → n → ℂ) :
    (rowCross p q)ᴴ = rowCross q p := by
  simp [rowCross, Matrix.conjTranspose_sum, Matrix.conjTranspose_vecMulVec]

/-- Row-Gram positivity, without any invertibility assumption. -/
theorem rowGram_posSemidef (p q : k → n → ℂ) :
    (Matrix.fromBlocks (rowMass p) (rowCross q p) (rowCross p q) (rowMass q)).PosSemidef := by
  have he : Matrix.fromBlocks (rowMass p) (rowCross q p) (rowCross p q) (rowMass q) =
      ∑ j, vecMulVec (Sum.elim (p j) (q j)) (star (Sum.elim (p j) (q j))) := by
    ext i l
    cases i <;> cases l <;> simp [rowMass, rowCross, Matrix.sum_apply,
      Matrix.fromBlocks, Matrix.vecMulVec_apply]
  rw [he]
  exact Matrix.posSemidef_sum Finset.univ
    (fun j _ => Matrix.posSemidef_vecMulVec_self_star _)

/-- The exact holomorphic pencil generated by an output-basis rotation. -/
theorem rowCross_rot (s t : ℂ) (p q : k → n → ℂ) :
    rowCross (fun j => star s • p j + star t • q j) (fun j => -t • p j + s • q j) =
      s ^ 2 • rowCross p q + (s * t) • (rowMass q - rowMass p) -
        t ^ 2 • (rowCross p q)ᴴ := by
  ext i j
  simp only [rowCross, rowMass, Matrix.sum_apply, Matrix.add_apply, Matrix.smul_apply,
    Matrix.sub_apply, Matrix.conjTranspose_apply, vecMulVec_apply, Pi.add_apply,
    Pi.smul_apply, Pi.star_apply, star_add, star_smul, star_star, star_sum,
    star_mul', smul_eq_mul, Finset.mul_sum, ← Finset.sum_sub_distrib,
    ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun k _ => by ring

/-- A normalized output rotation makes the cross Gram block singular for
an arbitrary positive input dimension. -/
theorem exists_rotated_singular_gram [Nonempty n] (p q : k → n → ℂ) :
    ∃ s t : ℂ, Complex.normSq s + Complex.normSq t = 1 ∧
      (rowCross (fun j => star s • p j + star t • q j)
        (fun j => -t • p j + s • q j)).det = 0 := by
  obtain ⟨s, t, hst, hdet⟩ := exists_unit_singular_cross (rowMass p) (rowMass q) (rowCross p q)
  exact ⟨s, t, hst, by rw [rowCross_rot]; exact hdet⟩

/-- Multiplying a Kraus operator by the output unitary produces the two
rotated rows in the preceding formula. -/
theorem rotU_mul_rows_general (s t : ℂ) (p q : n → ℂ) :
    QubitAdditivity.rotU s t * QubitOutputForm.rows p q =
      QubitOutputForm.rows (star s • p + star t • q) (-t • p + s • q) := by
  ext i j
  fin_cases i <;> simp [QubitAdditivity.rotU, QubitOutputForm.rows,
    Matrix.mul_apply, Fin.sum_univ_two]

end SchurEntropy.Qubit
